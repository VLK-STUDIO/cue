{
  "name": "@vlkoss/cue",
  "version": "0.4.0",
  "description": "Imperative React overlays with isolated Cue environments, typed shared components, and one shared backdrop.",
  "keywords": [
    "dialog",
    "imperative",
    "modal",
    "overlay",
    "react"
  ],
  "homepage": "https://github.com/VLK-STUDIO/cue#readme",
  "bugs": {
    "url": "https://github.com/VLK-STUDIO/cue/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VLK-STUDIO/cue.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "oxlint",
    "format": "oxfmt --check",
    "check-types": "tsc --noEmit",
    "test": "vitest run --typecheck",
    "prepublishOnly": "tsc"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "7.0.2",
    "vitest": "^4.0.10"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
